APP_NAME=Dairy AI Subscription Management
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Kolkata
CUSTOMER_CHANGE_CUTOFF_HOUR=20

DB_SERVER=(localdb)\MSSQLLocalDB
DB_DATABASE=DairySubscriptionDB
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=no
MSSQL_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=(localdb)\MSSQLLocalDB;DATABASE=DairySubscriptionDB;Trusted_Connection=yes;

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

N8N_BASE_URL=http://127.0.0.1:5678
# Leave empty until the n8n workflow and Gmail OAuth2 credential are configured.
N8N_WEBHOOK_URL=

DOCUMENT_STORAGE_PATH=./data/documents
FAISS_INDEX_PATH=./data/faiss_index
DOCUMENT_MAX_UPLOAD_MB=10
CUSTOMER_ISSUE_STORAGE_PATH=./data/customer_issues
CUSTOMER_ISSUE_MAX_PHOTO_MB=8
BACKUP_DIRECTORY=./backups
LOG_DIRECTORY=./logs
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5
LOG_LEVEL=INFO

